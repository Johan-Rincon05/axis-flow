# URL base de AXIS FLOW (dentro de docker-compose: http://zentao)
AXISFLOW_URL=http://localhost:8080
# Cuenta de servicio (debe estar en AXIS_SSO_LOCAL_ACCOUNTS si el SSO esta forzado)
AXISFLOW_ACCOUNT=axismcp
AXISFLOW_PASSWORD=
# Clave que deben presentar los clientes MCP (Authorization: Bearer <clave> o /mcp/<clave>)
MCP_AUTH_TOKEN=
PORT=3100
# Opcional: 1 = solo herramientas de lectura
MCP_READ_ONLY=0
